{"cells":[{"cell_type":"code","source":["import threading\n","import time\n","\n","# Nosso saldo inicial, igual ao do exemplo (R$ 1000)\n","# Usamos uma variável global para as duas threads mexerem na mesma conta\n","saldo = 1000\n","\n","# Função que representa a Thread A (que vai depositar dinheiro)\n","def thread_a():\n","    global saldo\n","\n","    # 1. Thread A lê saldo\n","    saldo_lido_a = saldo\n","    print(f\"Thread A lê saldo = R${saldo_lido_a}\")\n","\n","    # Pausa de 1 segundo para dar tempo da Thread B ler o saldo antigo também!\n","    # (É aqui que o problema da falta de sincronia acontece)\n","    time.sleep(1)\n","\n","    # 2. Thread A adiciona R$ 500 e escreve o novo valor\n","    novo_saldo = saldo_lido_a + 500\n","    saldo = novo_saldo\n","    print(f\"Thread A adiciona R$500 -> escreve R${saldo}\")\n","\n","# Função que representa a Thread B (que vai sacar dinheiro)\n","def thread_b():\n","    global saldo\n","\n","    # 1. Thread B lê saldo (se a Thread A ainda estiver pausada, vai ler 1000 também)\n","    saldo_lido_b = saldo\n","    print(f\"Thread B lê saldo = R${saldo_lido_b}\")\n","\n","    # Pausa um pouquinho maior para garantir que a Thread A escreva antes\n","    time.sleep(1.5)\n","\n","    # 2. Thread B subtrai R$ 200 e escreve o novo valor\n","    # Como ela leu 1000 lá atrás, a conta vai ser 1000 - 200 = 800\n","    novo_saldo = saldo_lido_b - 200\n","    saldo = novo_saldo\n","    print(f\"Thread B subtrai R$200 -> escreve R${saldo}\")\n","\n","# --- Início do Programa Principal ---\n","\n","print(\"Iniciando as transações no banco...\\n\")\n","\n","# Criando as duas \"linhas de execução\" (threads)\n","t1 = threading.Thread(target=thread_a)\n","t2 = threading.Thread(target=thread_b)\n","\n","# Dando o \"play\" nas duas ao mesmo tempo\n","t1.start()\n","t2.start()\n","\n","# O comando join() faz o programa principal esperar as duas threads terminarem\n","t1.join()\n","t2.join()\n","\n","print(\"\\n--- Fim das transações ---\")\n","print(f\"Saldo final: R${saldo} (INCORRECT!)\")\n","print(\"Deveria ser R$1300\")"],"metadata":{"id":"UKjgpaMuEpNB"},"execution_count":null,"outputs":[]}],"metadata":{"colab":{"provenance":[{"file_id":"/v2/external/notebooks/intro.ipynb","timestamp":1778503657573}]},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}