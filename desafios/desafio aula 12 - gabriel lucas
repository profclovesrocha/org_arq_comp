import java.util.Scanner;

// Gabriel Lucas

class ContaBancaria {
    private double saldo;

    ContaBancaria(double saldo) {
        this.saldo = saldo;
    }

    public void depositar(double valor) {

        if(valor > 0) {
            saldo += valor;
            System.out.println("Depositado com sucesso");
        } else {
            System.out.println("Deposito inválido");
        }
    }

    public void sacar(double valor) {

        if(valor > 0 && valor <= saldo) {
            saldo -= valor;
            System.out.println("Saque com sucesso");
        } else {
            System.out.println("Saque inválido");
        }
    }

    @Override
    public String toString() {
        return "Saldo: R$: " + saldo;
    }
}

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        ContaBancaria userA = new ContaBancaria(1000);
        ContaBancaria userB = new ContaBancaria(1000);

        System.out.println("Digite o deposito do usuario A");
        double deposito = sc.nextDouble();
        System.out.println("Digite o saque para o usuário B");
        double saque = sc.nextDouble();

        userA.depositar(deposito);

        System.out.println(userA);

        userB.sacar(saque);

        System.out.println(userB);

        sc.close();
    }
}
